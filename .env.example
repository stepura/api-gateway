# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=api-gateway
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_EXTERNAL_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MongoDB (credentials are also consumed by the mongo container on first init)
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=gateway
MONGO_INITDB_ROOT_PASSWORD=change-me-in-production
MONGO_INITDB_DATABASE=api_gateway
MONGO_DB=api_gateway
MONGO_EXTERNAL_PORT=27017

# Used when the app runs outside Docker. docker-compose.yml overrides this value
# with the internal "mongo" hostname. Percent-encode special chars in the URI.
MONGODB_URI=mongodb://gateway:change-me-in-production@127.0.0.1:27017/api_gateway?authSource=admin
MONGODB_DATABASE=api_gateway
MONGODB_CACHE_COLLECTION=response_cache
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_STARTUP_ATTEMPTS=10
MONGO_STARTUP_RETRY_DELAY_SECONDS=2

# -----------------------------------------------------------------------------
# Cache policy
# -----------------------------------------------------------------------------
DEFAULT_CACHE_TTL_SECONDS=300
# How long an EXPIRED entry stays in MongoDB (TTL index on purge_at removes it).
STALE_CACHE_RETENTION_SECONDS=86400
STALE_CACHE_FALLBACK_ENABLED=true
EXCHANGE_RATES_TTL_SECONDS=3600
SLOW_REPOSITORY_TTL_SECONDS=60

# -----------------------------------------------------------------------------
# Upstream HTTP clients and connectors
# -----------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=5
HTTP_CONNECT_TIMEOUT_SECONDS=3
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
EXCHANGE_RATES_BASE_URL=https://open.er-api.com/v6
SLOW_CONNECTOR_DELAY_SECONDS=2

# Debug-only: allows ?simulate_outage=true to exercise the stale-cache fallback.
# Set to false in production.
ENABLE_FAILURE_SIMULATION=true
